# ─────────────────────────────────────────────────────────────────────────────
# DocMind v2 — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (or Groq API Key starting with gsk_)
# If using Groq, the engine automatically defaults to HuggingFace embeddings + Llama 3.3 70B
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# Directory where ChromaDB stores vectors on disk
CHROMA_PERSIST_DIR=./chroma_store

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:8000
